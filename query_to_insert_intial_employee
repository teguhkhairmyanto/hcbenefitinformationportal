-- STEP D: Pindahkan dari staging ke tabel employees sesungguhnya,
-- sambil resolve kode teks -> ID lewat JOIN ke tabel master
INSERT INTO employees
(nrp, nama, tanggal_lahir, golongan_id, cabang_id, pangkat_id, kelompok_jabatan_id, status_keluarga_id, data_source)
SELECT
    s.nrp,
    s.nama,
    s.tanggal_lahir,
    g.id   AS golongan_id,
    c.id   AS cabang_id,
    p.id   AS pangkat_id,
    kj.id  AS kelompok_jabatan_id,
    sk.id  AS status_keluarga_id,
    'excel_import'
FROM stg_employees_import s
LEFT JOIN m_golongan g          ON g.code = s.gol_code
LEFT JOIN m_cabang c            ON c.code = s.cabang_code
LEFT JOIN m_pangkat p           ON p.code = s.pangkat_code
LEFT JOIN m_kelompok_jabatan kj ON kj.code = s.keljab_code
LEFT JOIN m_status_keluarga sk  ON sk.code = s.stkel_code;

-- STEP E: Cek apakah ada baris yang gagal ter-resolve (harusnya 0 baris jika data bersih)
SELECT s.nrp, s.nama, s.gol_code, s.cabang_code, s.keljab_code, s.stkel_code
FROM stg_employees_import s
LEFT JOIN m_golongan g          ON g.code = s.gol_code
LEFT JOIN m_cabang c            ON c.code = s.cabang_code
LEFT JOIN m_kelompok_jabatan kj ON kj.code = s.keljab_code
LEFT JOIN m_status_keluarga sk  ON sk.code = s.stkel_code
WHERE g.id IS NULL OR c.id IS NULL OR kj.id IS NULL OR sk.id IS NULL;

